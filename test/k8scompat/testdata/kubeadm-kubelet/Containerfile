FROM alpine AS fetch
ARG K8S_VERSION
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64) ARCH=amd64 ;; \
      aarch64) ARCH=arm64 ;; \
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    for bin in kubeadm kubelet; do \
      wget -qO "/$bin" "https://dl.k8s.io/${K8S_VERSION}/bin/linux/${ARCH}/${bin}"; \
      wget -qO "/$bin.sha256" "https://dl.k8s.io/${K8S_VERSION}/bin/linux/${ARCH}/${bin}.sha256"; \
      echo "$(cat /$bin.sha256)  /$bin" | sha256sum -c -; \
      chmod +x "/$bin"; \
    done

FROM debian:trixie-slim
COPY --from=fetch /kubeadm /kubeadm
COPY --from=fetch /kubelet /kubelet
